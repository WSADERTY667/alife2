```gitignore
# Python compiled files
*.pyc
__pycache__/

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
target/

# Dependencies
.venv/
venv/
node_modules/

# Coverage reports
.coverage
coverage/
htmlcov/

# MyPy cache
.mypy_cache/

# PyTest cache
.pytest_cache/

# System files
.DS_Store
Thumbs.db
```